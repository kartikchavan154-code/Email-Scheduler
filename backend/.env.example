# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database & Cache (PostgreSQL, Redis, Elasticsearch)
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_NODE=http://localhost:9200

# Security & Encryption (AES-256-GCM 32-byte hex key, JWT / Session Secret)
SESSION_SECRET=super_secret_session_jwt_key_at_least_32_characters_long
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth 2.0 & Web API
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_CALLBACK_URL=http://localhost:5000/api/slack/callback
SLACK_NOTIFICATIONS_ENABLED=true

# Nodemailer / Default Ethereal SMTP Settings (leave empty to auto-create test account)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

# Email Worker Concurrency & Distributed Rate Limiter
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
RATE_LIMIT_TIMEZONE=UTC

# Bull Board Queue Monitoring Dashboard
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin
