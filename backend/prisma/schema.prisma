generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model User {
  id               String            @id @default(uuid())
  googleId         String?           @unique
  name             String
  email            String            @unique
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  senders          Sender[]
  batches          EmailBatch[]
  emails           Email[]
  slackConnection  SlackConnection?

  @@index([email])
  @@index([googleId])
}

model Sender {
  id             String      @id @default(uuid())
  userId         String
  name           String
  email          String
  // Ethereal or custom SMTP settings stored securely
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String?
  smtpPass       String?     // encrypted or test ethereal password
  hourlyLimit    Int         @default(200)
  enabled        Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails         Email[]

  @@unique([userId, email])
  @@index([userId])
}

model EmailBatch {
  id                   String      @id @default(uuid())
  userId               String
  senderId             String?
  subject              String
  body                 String
  startTime            DateTime
  delayBetweenEmails   Int         @default(2) // in seconds
  hourlyLimit          Int         @default(200)
  totalRecipients      Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails               Email[]

  @@index([userId])
  @@index([createdAt])
}

model Email {
  id               String       @id @default(uuid())
  userId           String
  senderId         String
  batchId          String?
  recipientEmail   String
  subject          String
  body             String
  scheduledAt      DateTime
  sentAt           DateTime?
  status           EmailStatus  @default(SCHEDULED)
  bullmqJobId      String?
  idempotencyKey   String       @unique
  retryCount       Int          @default(0)
  errorMessage     String?
  etherealPreviewUrl String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender           Sender       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  batch            EmailBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, scheduledAt])
  @@index([userId, sentAt])
  @@index([senderId, scheduledAt])
  @@index([bullmqJobId])
  @@index([status, scheduledAt])
}

model SlackConnection {
  id                  String   @id @default(uuid())
  userId              String   @unique
  slackWorkspaceId    String
  slackWorkspaceName  String?
  channelId           String?
  encryptedOAuthToken String
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
